# Non-secret example only. Inject all three secrets from an approved secret manager.
MYORG_HOST=127.0.0.1
MYORG_PORT=8080
MYORG_DB=/var/lib/myorg/myorg.db
MYORG_ALLOWED_ORIGINS=https://control.example.com
MYORG_BEHIND_TLS=1
MYORG_LOG_LEVEL=INFO
MYORG_BACKUP_DIR=/var/lib/myorg/backups
MYORG_IDEMPOTENCY_RETENTION_DAYS=30
# What one run may spend before it parks and asks. 0 disables the ceiling.
# $5 is measured, not chosen: a graded step costs ~$0.80 warm and ~$2.80 cold, so
# this buys a normal run and stops a retry loop on its third attempt.
MYORG_RUN_CEILING_USD=5
# How a person is told the company needs them. Notices (a decision waiting, a run that
# stopped, a run gone quiet) collect in the outbox; this command is run once per notice
# with the notice as JSON in its last argument. Unset, nobody is told -- the scheduler
# warns about that at every start. See docs/OPERATIONS-RUNBOOK.md#being-told
# The shipped sink files one GitHub issue per notice (an inbox, not paging):
MYORG_NOTIFY_COMMAND=python3 scripts/notify_github.py
MYORG_NOTIFY_GITHUB_REPO=DipurajThapa/MyOrg
# The service account needs `gh` authentication. Where it has no login of its own, a
# fine-grained token for this repository with Issues: read+write only -- never committed:
# GH_TOKEN=
# MYORG_OUTBOX=/var/lib/myorg/runs/_outbox.jsonl
# Required secrets (names only; never commit values):
# At least 32 bytes. Accepts `current,previous` during a rotation -- tokens are signed
# with the first and verified against either. See docs/OPERATIONS-RUNBOOK.md#rotating-the-signing-key
# MYORG_AUTH_SECRET=
# Inbound webhook signing secrets are separate, one per connector, named
# <SECRET_REF>_WEBHOOK_SECRET -- never reuse the outbound bearer token for them.
# MYORG_GATEWAY_SECRET=
# MYORG_METRICS_TOKEN=   # /metrics answers 404 without it
