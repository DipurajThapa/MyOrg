[Unit]
Description=MyOrg transient-data retention and integrity check
After=myorg-api.service

[Service]
Type=oneshot
User=myorg
Group=myorg
WorkingDirectory=/opt/myorg
EnvironmentFile=/etc/myorg/myorg.env
ExecStart=/opt/myorg/scripts/maintain_runtime.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myorg
